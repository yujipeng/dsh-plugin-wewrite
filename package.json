{
  "name": "dsh-plugin-wewrite",
  "version": "0.1.0",
  "description": "WeWrite 写作工作台作为 DeepSeek Harness (DSH) 插件的工程骨架与契约层（S1）",
  "repository": {
    "type": "git",
    "url": "github:yujipeng/dsh-plugin-wewrite"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./shared": {
      "types": "./lib/types/shared/index.d.ts",
      "default": "./lib/shared.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
